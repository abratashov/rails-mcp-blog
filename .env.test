################################################# LLM (vllm)
LLM_PROVIDER=vllm
LLM_ACCESS_TOKEN=vllm
LLM_MODEL="Qwen/Qwen3-4B-AWQ"
LLM_URL=http://localhost:8000/v1

################################################# RAG Embedding Settings
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=0
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_CONFIGURATION_VERSION=1
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_INPUT_CHARACTERS=12000

####################### RAG Embedding (OpenAI compatible - ollama/vllm)
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=test-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_SEND_DIMENSIONS=true

################################################# RAILS
USER_EMAIL=test@test.org
USER_PASSWORD=test@test.org
