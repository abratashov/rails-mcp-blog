<%= form_with(model: post) do |form| %>
  <% if post.errors.any? %>
    <div class="posts-page__errors" role="alert">
      <h2><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>

      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="posts-page__field">
    <%= form.label :title %>
    <%= form.text_field :title, required: true, autofocus: true %>
  </div>

  <div class="posts-page__field">
    <%= form.label :body %>
    <%= form.textarea :body, rows: 10 %>
  </div>

  <div class="posts-page__form-actions">
    <%= form.submit "Publish post", class: "button" %>
  </div>
<% end %>
