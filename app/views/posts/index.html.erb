<% content_for :title, "Posts" %>

<main class="posts-page">
  <% if notice.present? %>
    <p class="posts-page__notice"><%= notice %></p>
  <% end %>

  <header class="posts-page__header">
    <h1>Posts</h1>
    <%= link_to "New post", new_post_path, class: "button" %>
  </header>

  <section class="posts-page__list" aria-label="Posts">
    <%= render "posts" %>
    <%= turbo_stream_from "posts" %>
  </section>
</main>
