<% content_for :title, @prompt.fetch(:title) %>

<main class="prompt-runner" data-controller="scroll-to-bottom">
  <% if notice.present? %>
    <p class="prompt-runner__notice"><%= notice %></p>
  <% end %>

  <header class="prompt-runner__header">
    <div>
      <p class="prompt-runner__eyebrow"><%= link_to "All prompts", prompts_path %></p>
      <h1><%= @prompt.fetch(:title) %></h1>
      <% if @prompt[:description].present? %>
        <p><%= @prompt[:description] %></p>
      <% end %>
    </div>
  </header>

  <% if @error.present? %>
    <p class="prompt-runner__error" role="alert"><%= @error %></p>
  <% end %>

  <% if @started %>
    <section class="prompt-runner__conversation" aria-label="Prompt conversation" aria-live="polite">
      <% @messages.drop(1).each do |message| %>
        <% role = message["role"].to_s %>
        <% content = message["content"].to_s %>
        <% next unless %w[user assistant].include?(role) && content.present? %>

        <article class="prompt-runner__message prompt-runner__message--<%= role %>">
          <h2><%= role == "assistant" ? @prompt.fetch(:title) : "You" %></h2>
          <div class="prompt-runner__message-content">
            <% if role == "assistant" %>
              <%= prompt_markdown(content) %>
            <% else %>
              <%= simple_format(content) %>
            <% end %>
          </div>
        </article>
      <% end %>
    </section>

    <%= form_with url: prompt_runner_path(@prompt.fetch(:name)), method: :post, class: "prompt-runner__form" do |form| %>
      <%= form.label :message, "Your response" %>
      <%= form.text_area :message, value: @message, rows: 5, maxlength: AI::PromptRunnerSession::MAX_MESSAGE_LENGTH, required: true, placeholder: "Write your response here..." %>
      <%= form.submit "Send response", class: "button" %>
    <% end %>

    <div class="prompt-runner__actions">
      <%= button_to "End Session", prompt_runner_path(@prompt.fetch(:name)), method: :delete, class: "button button--secondary" %>
    </div>
  <% else %>
    <section class="prompt-runner__welcome">
      <p><%= @prompt[:description].presence || "Start an interactive session with this prompt." %></p>
      <%= form_with url: prompt_runner_path(@prompt.fetch(:name)), method: :post, class: "prompt-runner__form" do |form| %>
        <% @prompt.fetch(:arguments).each do |argument| %>
          <% name = argument.fetch(:name) %>
          <div>
            <%= label_tag "arguments_#{name}", argument[:title].presence || name.humanize %>
            <% if argument[:description].present? %>
              <p><%= argument[:description] %></p>
            <% end %>
            <%= text_field_tag "arguments[#{name}]", @arguments[name.to_s], id: "arguments_#{name}", required: argument[:required] %>
          </div>
        <% end %>
        <%= form.submit "Run prompt", class: "button" %>
      <% end %>
    </section>
  <% end %>
</main>
