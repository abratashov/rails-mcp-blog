# LLM_ACCESS_TOKEN=LLM_ACCESS_TOKEN
# LLM_MODEL="openrouter/free"
# LLM_URL=https://openrouter.ai/api/v1

################################################# LLM (vllm)
LLM_PROVIDER=vllm
LLM_ACCESS_TOKEN=vllm
LLM_MODEL="Qwen/Qwen3-4B-AWQ"
LLM_URL=http://localhost:8000/v1

################################################# RAG Embedding Settings
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=0
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_CONFIGURATION_VERSION=1
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_INPUT_CHARACTERS=12000

####################### RAG Embedding (OpenRouter)
# EMBEDDING_API_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_API_KEY=OPENROUTER_API_KEY
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_SEND_DIMENSIONS=true

####################### RAG Embedding (OpenAI)
# EMBEDDING_API_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=OPENAI_API_KEY
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_SEND_DIMENSIONS=true

####################### RAG Embedding (OpenAI compatible - ollama/vllm)
EMBEDDING_API_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_SEND_DIMENSIONS=false

####################### RAG Answer Settings
LLM_ANSWER_CREATIVITY=0.2
QUERY_CLASSIFIER_CONFIDENCE_THRESHOLD=0.6
# QUERY_CLASSIFIER_PROVIDER=LLM_PROVIDER
# QUERY_CLASSIFIER_MODEL=LLM_MODEL
RAG_ANALYSIS_ANSWER_MAX_TOKENS=2000
RAG_ANALYSIS_BATCH_SIZE=8
RAG_ANALYSIS_CONFIDENCE_THRESHOLD=0.7
RAG_ANALYSIS_EXTRACTION_MAX_TOKENS=2000
RAG_ANALYSIS_MAX_INPUT_TOKENS=6000
RAG_ANALYSIS_MAX_RETRIES=2
RAG_ANALYSIS_RETRY_DELAY=0.1
RAG_COMPARATIVE_TOP_K=3

