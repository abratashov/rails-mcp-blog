USER_PASSWORD=test@test.org

################################################# RAG
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=0
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_DIMENSIONS=1536
EMBEDDING_SEND_DIMENSIONS=true
EMBEDDING_CONFIGURATION_VERSION=1
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_INPUT_CHARACTERS=12000

####################### RAG (OpenRouter)
EMBEDDING_API_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=OPENROUTER_API_KEY
